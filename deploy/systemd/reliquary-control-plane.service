[Unit]
Description=Reliquary Control Plane
After=network-online.target reliquary-vllm.service
Wants=network-online.target

[Service]
Type=simple
User=reliquary
WorkingDirectory=/srv/reliquary/current
EnvironmentFile=/srv/reliquary/state/reliquary.env
ExecStart=/bin/bash -lc 'exec /opt/miniforge/bin/conda run --no-capture-output -n reliquary-app reliquary serve-control-plane --host "$RELIQUARY_API_BIND" --port "$RELIQUARY_API_PORT"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
