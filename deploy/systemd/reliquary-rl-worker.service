[Unit]
Description=Reliquary Reasoning RL Worker
After=network-online.target reliquary-control-plane.service
Wants=network-online.target

[Service]
Type=simple
User=reliquary
WorkingDirectory=/srv/reliquary/current
EnvironmentFile=/srv/reliquary/state/reliquary.env
ExecStart=/bin/bash -lc 'exec /srv/reliquary/current/deploy/run-rl-worker.sh'
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
