{
  "uid": "reliquary-training",
  "title": "Reliquary Training (Forge)",
  "tags": ["reliquary", "training", "forge", "epic5"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "",
  "time": {"from": "now-6h", "to": "now"},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Loss",
      "description": "Per-run last-step loss (solid) and rolling 32-step mean (dashed) from reliquary_training_loss_last / _loss_mean_window.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "palette-classic"},
          "custom": {"lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": [
          {
            "matcher": {"id": "byRegexp", "options": "mean .*"},
            "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash"}}]
          }
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "expr": "reliquary_training_loss_last",
          "legendFormat": "last {{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "refId": "B",
          "expr": "reliquary_training_loss_mean_window",
          "legendFormat": "mean {{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Advantage variance",
      "description": "Variance of per-sample advantages in the current micro-batch — proxy for GRPO group-relative signal strength.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "expr": "reliquary_training_advantage_variance_last",
          "legendFormat": "{{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "KL divergence vs reference",
      "description": "Per-step KL between current policy and reference — should stay in clip_eps band for stable GRPO.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.1},
              {"color": "red", "value": 0.3}
            ]
          },
          "custom": {"lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "expr": "reliquary_training_kl_last",
          "legendFormat": "{{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gradient norm",
      "description": "L2 norm of gradients at each step — watch for divergence vs the clip value.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "expr": "reliquary_training_grad_norm_last",
          "legendFormat": "{{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Step time",
      "description": "Wall-clock seconds per optimizer step — includes forward, backward, optimizer, and any all-reduce.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"lineInterpolation": "linear", "fillOpacity": 5}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "expr": "reliquary_training_step_seconds_last",
          "legendFormat": "{{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total steps + samples",
      "description": "Run-total optimizer steps and training-eligible samples consumed.",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "gray", "value": null}]
          }
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "targets": [
        {
          "refId": "A",
          "expr": "reliquary_training_steps_total",
          "legendFormat": "steps {{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "refId": "B",
          "expr": "reliquary_training_samples_accepted_total",
          "legendFormat": "samples {{run_id}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
