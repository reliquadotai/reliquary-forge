# Reliquary Forge — testnet (netuid 462) trainer template.
# Copy to .env (gitignored) and fill in site-specific values.
# Quickstart: cp env.testnet.example .env && edit, then bash scripts/launch_trainer.sh
#
# For local-demo defaults (no chain writes), use env.example instead.

# ────────  Chain  ────────
NETWORK=test
NETUID=462
RELIQUARY_CHAIN_ENDPOINT=wss://test.finney.opentensor.ai:443

# ────────  Wallet  ────────
# Trainer hotkey is one of the existing validator hotkeys (Forge runs alongside
# a Ledger validator process and consumes its verdicts).
BT_WALLET_PATH=~/.bittensor/wallets
WALLET_NAME=reliquary-ledger
HOTKEY_NAME=trainer
RELIQUARY_TRAINER_ID=

# ────────  Model + GPU  ────────
RELIQUARY_DEVICE=cuda:0
RELIQUARY_MODEL_NAME=Qwen/Qwen3-4B-Instruct
RELIQUARY_MODEL_TEACHER=Qwen/Qwen3-8B
RELIQUARY_MODEL_STUDENT=Qwen/Qwen3-4B
RELIQUARY_VLLM_BASE_URL=http://127.0.0.1:8001
RELIQUARY_VLLM_MODEL=Qwen/Qwen3-8B
RELIQUARY_VLLM_GPU_MEMORY_UTILIZATION=0.65

# ────────  GRPO training  ────────
RELIQUARY_TRAIN_LR=5e-6
RELIQUARY_CLIP_EPS=0.2
RELIQUARY_KL_COEF=0.04
RELIQUARY_TRAIN_EPOCHS=1
RELIQUARY_WINDOW_LENGTH=30
RELIQUARY_ROLLOUTS_PER_CHALLENGE=8
RELIQUARY_MAX_NEW_TOKENS=512
RELIQUARY_TEMPERATURE=0.9
RELIQUARY_TOP_P=1.0

# ────────  HF Hub continuous publishing (Phase 1.4 side-channel)  ────────
# When set, Forge publishes a full HF snapshot every 10 windows alongside the
# delta-checkpoint flow. Leave blank to keep delta-only.
RELIQUARY_HF_REPO_ID=
RELIQUARY_HF_TOKEN=
RELIQUARY_HF_PUBLISH_INTERVAL_WINDOWS=10

# ────────  Storage (R2)  ────────
RELIQUARY_R2_BUCKET=reliquary-forge-testnet
RELIQUARY_R2_ENDPOINT_URL=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
RELIQUARY_R2_ACCESS_KEY_ID=
RELIQUARY_R2_SECRET_ACCESS_KEY=

# ────────  State + logs  ────────
RELIQUARY_STATE_ROOT=./data
RELIQUARY_ARTIFACT_DIR=./data/artifacts
RELIQUARY_EXPORT_DIR=./data/exports
RELIQUARY_LOG_DIR=./data/logs

# ────────  W&B (optional, validator-only)  ────────
WANDB_PROJECT=reliquary-forge-testnet
WANDB_API_KEY=

# ────────  API + service  ────────
RELIQUARY_API_BIND=127.0.0.1
RELIQUARY_API_PORT=8000
RELIQUARY_NODE_LABEL=
RELIQUARY_HOST_MODE=remote
RELIQUARY_SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
